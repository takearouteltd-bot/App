{
  "expo": {
    "name": "takearoute",
    "slug": "takearoute",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/myicon.png",
    "scheme": "takearoute",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#00356D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.takearoute.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "googleMapsApiKey": "AIzaSyD2FkUIMuw3hkXi827QxnI8W1w2XX_KGd8"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/myicon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "package": "com.takearoute.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD2FkUIMuw3hkXi827QxnI8W1w2XX_KGd8"
        }
      },
      "permissions": [
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "TakeARoute uses the camera so drivers can take a live verification selfie.",
          "photosPermission": "TakeARoute uses your photos so you can upload documents and a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#86C814",
          "sounds": [
            "./assets/sounds/job_alert.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00356D",
          "image": "./assets/myicon.png",
          "imageWidth": 200,
          "ios": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "cover",
            "backgroundColor": "#00356D",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "image": "./assets/myicon.png",
            "imageWidth": 200,
            "backgroundColor": "#00356D"
          }
        }
      ],
      "./plugins/withLightOnly",
      "./plugins/withNotificationColorOverride"
    ]
  }
}
