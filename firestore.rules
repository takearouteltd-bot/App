rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        adminDoc().data.isActive == true;
    }

    function isSuperAdmin() {
      return isAdmin() && adminDoc().data.role == "super_admin";
    }

    /* Fleet staff (owner or operator) of a taxi firm on TakeARoute. See
       functions/fleet.js. */
    function fleetStaffOf(fleetId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/fleetManagers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/fleetManagers/$(request.auth.uid)).data.isActive == true &&
        get(/databases/$(database)/documents/fleetManagers/$(request.auth.uid)).data.fleetId == fleetId;
    }

    function fleetOwnerOf(fleetId) {
      return fleetStaffOf(fleetId) &&
        get(/databases/$(database)/documents/fleetManagers/$(request.auth.uid)).data.role == "owner";
    }

    /* ================= APP CONFIG ================= */

    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* ================= ADMIN MESSAGES ================= */

    match /announcements/{messageId} {
      allow read: if isAdmin() || (
        signedIn() &&
        (resource.data.audience != "user" || resource.data.userId == request.auth.uid)
      );
      allow write: if isAdmin();
    }

    /* ================= PROMO CODES ================= */

    match /promoCodes/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* ================= PUSH TOKENS (NEW) ================= */
    /* Each phone saves its own notification token. Cloud Functions read
       these with admin access, so no read rule is needed for them. */

    match /pushTokens/{userId} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    /* ================= DRIVER CHANGE REQUESTS (NEW) ================= */
    /* Drivers ask to change protected details or documents. Nothing is
       applied until an admin approves it. */

    match /changeRequests/{requestId} {
      allow create: if signedIn() &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.status == "pending";
      allow read: if isAdmin() || (
        signedIn() && resource.data.driverId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    /* ================= RIDERS ================= */

    /* Fields the server owns on a rider: what Stripe charges, and whether
       the account is suspended. The default card may only be one of the
       rider's own saved cards (UPDATED). */
    function riderKeepsGuardedFields(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(["stripeCustomerId", "blocked", "rating", "ratingCount"]) &&
        (!changed.hasAny(["defaultPaymentMethodId"]) ||
          request.resource.data.defaultPaymentMethodId == null ||
          exists(/databases/$(database)/documents/riders/$(userId)/cards/$(request.resource.data.defaultPaymentMethodId)));
    }

    match /riders/{userId} {
      allow read: if isAdmin() || signedIn();
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.get("blocked", false) == false &&
        !("stripeCustomerId" in request.resource.data)
      );
      allow update: if isAdmin() || (
        signedIn() &&
        (
          (request.auth.uid == userId && riderKeepsGuardedFields(userId)) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "rating"
          ])
        )
      );
      allow delete: if isAdmin();

      match /cards/{cardId} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }

      match /recentSearches/{searchId} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }

      match /savedPlaces/{placeId} {
        allow read, write: if isAdmin() || (signedIn() && request.auth.uid == userId);
      }
    }

    /* ================= DRIVERS ================= */

    /* Fields a driver may not change on their own once they are onboarded.
       These go through changeRequests, or an admin edits them directly. */
    function protectedDriverFields() {
      return [
        "firstName", "lastName", "fullName", "phoneNumber", "phone",
        "email", "address", "documentExpiry", "approved", "blocked",
        "onboardingStatus", "rejectionReason", "autoPayout",
        "documentExpiryDetected", "payoutAccountId", "payoutAccountFingerprint",
        "payoutTermsAcceptance",
        "driverLicenseFrontUrl", "driverLicenseBackUrl", "pcoLicenseUrl",
        "vehicleLicenceUrl", "insuranceUrl", "motUrl", "dbsCertificateUrl",
        "accountDetails"
      ];
    }

    /* Only admins and Cloud Functions decide these. A driver may write
       approved: false (onboarding does), never true (UPDATED). */
    function driverGrantsNothing(data) {
      return data.get("approved", false) == false &&
        data.get("blocked", false) == false &&
        !data.keys().hasAny(["blockedByFleet"]) &&
        data.get("femaleVerified", false) == false &&
        !("subscription" in data) &&
        !data.keys().hasAny(["fleetId", "fleetName", "fleetRequest", "fleetInvite",
          "fleetDriverType"]);
    }

    /* The first month's membership has not been paid. Later renewals have a
       grace period instead, and a fleet pays for its company drivers. */
    function owesFirstMembership() {
      let sub = resource.data.get("subscription", null);
      return sub is map &&
        sub.get("paymentMethod", "") != "fleet" &&
        sub.get("debtAmount", 0) > 0 &&
        sub.get("lastPaidAt", null) == null;
    }

    function driverKeepsGuardedFields() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(["subscription", "femaleVerified", "blocked",
          "blockedReason", "blockedBy", "blockedAt", "blockedByFleet"]) &&
        /* Joining and leaving a fleet go through functions/fleet.js. */
        !changed.hasAny(["fleetId", "fleetName", "fleetJoinedAt", "fleetRequest",
          "fleetInvite", "subscriptionBeforeFleet", "lastFleetId", "fleetLeftAt",
          "fleetLeftBy", "fleetDriverType"]) &&
        /* Hours and rest are kept by enforceDriverHours and admins. */
        !changed.hasAny(["workLog", "restUntil", "restStartedAt", "restDue",
          "restEndedEarlyAt", "restEndedEarlyBy"]) &&
        (!changed.hasAny(["approved"]) || request.resource.data.approved == false);
    }

    match /drivers/{driverId} {
      allow read: if isAdmin() || signedIn();
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == driverId &&
        driverGrantsNothing(request.resource.data)
      );
      allow update: if isAdmin() || (
        signedIn() &&
        (
          (
            request.auth.uid == driverId &&
            driverKeepsGuardedFields() &&
            /* Only an approved driver can put themselves online, and not
               one an admin has blocked (except finishing a trip they were
               on when blocked, so the trip still closes; they get no jobs
               after it). */
            !(request.resource.data.status == "online" &&
              resource.data.approved != true) &&
            !(request.resource.data.status == "online" &&
              resource.data.get("blocked", false) == true &&
              resource.data.get("status", "offline") != "on_ride") &&
            /* ...and not before paying for their first month. Only from
               offline, so a trip in progress can still finish. */
            !(request.resource.data.status == "online" &&
              resource.data.get("status", "offline") == "offline" &&
              owesFirstMembership()) &&
            /* ...and not while resting after their hours limit. */
            !(request.resource.data.status == "online" &&
              resource.data.status != "online" &&
              resource.data.get("restUntil", null) is timestamp &&
              resource.data.restUntil > request.time) &&
            (
              resource.data.onboardingComplete != true ||
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(protectedDriverFields())
            )
          ) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "rating"
          ])
        )
      );
      allow delete: if isAdmin();
    }

    /* ================= USERS ================= */

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    /* ================= RIDES ================= */

    /* Vehicle classes (NEW): a driver may only claim a job their vehicle
       qualifies for. Keep in step with constants/vehicleClasses.js. Unknown
       or missing classes count as RouteMini, as they do in the app. */
    function serves(vehicleType) {
      let m = {
        "RouteMini":      ["RouteMini"],
        "RoutePlus":      ["RoutePlus", "RouteMini"],
        "RouteXL":        ["RouteXL", "RoutePlus", "RouteMini"],
        "RouteEco":       ["RouteEco", "RouteMini"],
        "RouteExecutive": ["RouteExecutive", "RoutePlus", "RouteMini"]
      };
      return (vehicleType is string && vehicleType in m) ? m[vehicleType] : m["RouteMini"];
    }

    function rideClass(rideType) {
      return (rideType is string &&
        rideType in ["RouteMini", "RoutePlus", "RouteXL", "RouteEco", "RouteExecutive"])
        ? rideType : "RouteMini";
    }

    function rideChanged() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function riderCancels() {
      return rideChanged().hasOnly(["status", "cancelledBy", "cancelReason", "endedEarly", "cancelledAt"]) &&
        request.resource.data.status == "cancelled" &&
        request.resource.data.cancelledBy == "rider" &&
        resource.data.status in ["searching", "accepted", "arrived", "ongoing"];
    }

    function riderChangesPreference() {
      return rideChanged().hasOnly(["femaleDriverOnly", "femalePreferenceDropped"]) &&
        resource.data.status == "searching";
    }

    /* Raise only, and the card hold (fareEstimate) stays equal to the fare. */
    function riderRaisesOffer() {
      return rideChanged().hasOnly(["offeredFare", "fareEstimate", "fare"]) &&
        resource.data.status == "searching" &&
        request.resource.data.offeredFare is number &&
        request.resource.data.offeredFare >= resource.data.get("offeredFare", 0) &&
        request.resource.data.fareEstimate == request.resource.data.offeredFare &&
        request.resource.data.fare.total == request.resource.data.offeredFare;
    }

    /* The offer is only read once the write has the right shape, so a
       missing offer document cannot break the other rider paths. */
    function offerMatchesWrite(rideId) {
      let offer = get(/databases/$(database)/documents/rides/$(rideId)/offers/$(request.resource.data.driverId)).data;
      let driver = get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data;
      // The driver must still be free: one who has since taken another job
      // or gone offline cannot be handed this one.
      return offer.driverId == request.resource.data.driverId &&
        offer.status == "pending" &&
        request.resource.data.offeredFare == offer.price &&
        request.resource.data.fareEstimate == offer.price &&
        request.resource.data.fare.total == offer.price &&
        driver.get("status", "") == "online" &&
        driver.get("isOnRide", false) != true;
    }

    function riderTakesOffer(rideId) {
      return rideChanged().hasOnly(["status", "driverId", "acceptedAt", "walletProcessed",
          "offeredFare", "fareEstimate", "fare", "acceptedOfferId"]) &&
        resource.data.status == "searching" &&
        request.resource.data.status == "accepted" &&
        request.resource.data.walletProcessed == false &&
        request.resource.data.driverId is string &&
        offerMatchesWrite(rideId);
    }

    function riderRatesDriver() {
      return rideChanged().hasOnly(["driverRating"]) &&
        resource.data.status == "completed" &&
        !("driverRating" in resource.data);
    }

    function riderRideUpdate(rideId) {
      return request.auth.uid == resource.data.riderId && (
        riderCancels() || riderChangesPreference() || riderRaisesOffer() ||
        riderRatesDriver() || riderTakesOffer(rideId)
      );
    }

    /* A free driver takes a searching job. */
    function driverClaimsRide() {
      return rideChanged().hasOnly(["status", "driverId", "acceptedAt", "walletProcessed"]) &&
        resource.data.status == "searching" &&
        request.resource.data.status == "accepted" &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.walletProcessed == false &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid))
          .data.approved == true &&
        // Over the hours limit: the rest starts after the current trip, so
        // no new job in between.
        get(/databases/$(database)/documents/drivers/$(request.auth.uid))
          .data.get("restDue", false) != true &&
        // A blocked driver takes nothing, a passenger who blocked this
        // driver never gets them, and female-only jobs need a verified
        // female driver. The app filters these too; this makes it binding.
        get(/databases/$(database)/documents/drivers/$(request.auth.uid))
          .data.get("blocked", false) != true &&
        !(request.auth.uid in resource.data.get("blockedDriverIds", [])) &&
        (resource.data.get("femaleDriverOnly", false) != true ||
          get(/databases/$(database)/documents/drivers/$(request.auth.uid))
            .data.get("femaleVerified", false) == true) &&
        myVehicleServes(resource.data);
    }

    function driverArrives() {
      return rideChanged().hasOnly(["status", "arrivedAt", "arrivedAwayFromPickupM"]) &&
        resource.data.status == "accepted" && request.resource.data.status == "arrived";
    }

    function driverStarts() {
      return rideChanged().hasOnly(["status", "startedAt"]) &&
        resource.data.status == "arrived" && request.resource.data.status == "ongoing";
    }

    function driverReachesStop() {
      return rideChanged().hasOnly(["stopsCompleted"]) &&
        resource.data.status == "ongoing";
    }

    function driverCompletes() {
      return rideChanged().hasOnly(["status", "completedAt", "expiresAt", "cashCollected",
          "completedAwayFromDropoff", "completeDistanceKm"]) &&
        resource.data.status == "ongoing" && request.resource.data.status == "completed";
    }

    /* An app job goes back to searching; a phone job goes back to its
       fleet's operator (dispatching). */
    function driverGivesBack() {
      return rideChanged().hasOnly(["status", "driverId", "acceptedAt", "declinedBy", "lastDriverCancelAt"]) &&
        resource.data.status in ["accepted", "arrived"] &&
        request.resource.data.status ==
          (resource.data.get("source", "app") == "phone" ? "dispatching" : "searching") &&
        request.resource.data.driverId == null;
    }

    /* Phone jobs (functions/fleet.js): a driver of the job's fleet takes
       one sent to them, or to the whole fleet. */
    function driverClaimsFleetJob() {
      let driver = get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data;
      return rideChanged().hasOnly(["status", "driverId", "acceptedAt", "walletProcessed"]) &&
        resource.data.status == "dispatching" &&
        resource.data.get("fleetId", null) is string &&
        driver.get("fleetId", null) == resource.data.fleetId &&
        resource.data.dispatch.get("driverId", null) in [null, request.auth.uid] &&
        !(request.auth.uid in resource.data.get("declinedBy", [])) &&
        request.resource.data.status == "accepted" &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.walletProcessed == false &&
        driver.approved == true &&
        driver.get("blocked", false) != true &&
        driver.get("restDue", false) != true &&
        myVehicleServes(resource.data);
    }

    /* The chosen driver, or one of the fleet, says no to a phone job. */
    function driverDeclinesFleetJob() {
      let driver = get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data;
      return rideChanged().hasOnly(["declinedBy"]) &&
        resource.data.status == "dispatching" &&
        driver.get("fleetId", null) == resource.data.get("fleetId", "") &&
        request.resource.data.declinedBy.toSet() ==
          resource.data.get("declinedBy", []).toSet().union([request.auth.uid].toSet()) &&
        request.resource.data.declinedBy.size() <= resource.data.get("declinedBy", []).size() + 1;
    }

    function driverCancels() {
      return rideChanged().hasOnly(["status", "cancelledBy", "cancelReason", "endedEarly", "cancelledAt"]) &&
        request.resource.data.status == "cancelled" &&
        request.resource.data.cancelledBy == "driver" &&
        resource.data.status in ["accepted", "arrived", "ongoing"];
    }

    function driverRatesRider() {
      return rideChanged().hasOnly(["riderRating"]) &&
        resource.data.status == "completed" &&
        !("riderRating" in resource.data);
    }

    function driverRideUpdate() {
      return request.auth.uid == resource.data.driverId && (
        driverArrives() || driverStarts() || driverReachesStop() || driverCompletes() ||
        driverGivesBack() || driverCancels() || driverRatesRider()
      );
    }

    function myVehicleServes(ride) {
      return rideClass(ride.get("rideType", "RouteMini")) in serves(
        get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data.get("vehicleType", "RouteMini")
      );
    }

    match /rides/{rideId} {
      allow read: if isAdmin() || signedIn();

      allow create: if isAdmin() || (
        signedIn() &&
        request.resource.data.riderId == request.auth.uid
      );

      /* Updates are limited to what each side legitimately does, field by
         field, so nobody can rewrite the fare, the payment state or the
         other side's rating (UPDATED). Money is settled by the server from
         these fields, which is why they are locked. */
      allow update: if isAdmin() || (
        signedIn() && (
          riderRideUpdate(rideId) || driverClaimsRide() || driverRideUpdate() ||
          driverClaimsFleetJob() || driverDeclinesFleetJob()
        )
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || (
          signedIn() && (
            request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.riderId ||
            request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.driverId
          )
        );

        allow create: if isAdmin() || (
          signedIn() &&
          request.auth.uid == request.resource.data.senderId &&
          (
            request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.riderId ||
            request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.driverId
          )
        );

        allow update: if isAdmin() || (
          signedIn() &&
          request.auth.uid != resource.data.senderId &&
          (
            request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.riderId ||
            request.auth.uid == get(/databases/$(database)/documents/rides/$(rideId)).data.driverId
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
        );

        allow delete: if isAdmin();
      }

      /* Bidding counter-offers (NEW): one per driver, under their own uid.
         The ride's passenger reads them and marks the one they take. */
      match /offers/{offerDriverId} {
        allow read: if isAdmin() || (
          signedIn() && (
            request.auth.uid == offerDriverId ||
            get(/databases/$(database)/documents/rides/$(rideId)).data.riderId == request.auth.uid
          )
        );
        allow create, update: if isAdmin() || (
          signedIn() && (
            (
              request.auth.uid == offerDriverId &&
              request.resource.data.driverId == offerDriverId &&
              request.resource.data.status == "pending" &&
              get(/databases/$(database)/documents/rides/$(rideId)).data.status == "searching"
            ) || (
              resource != null &&
              get(/databases/$(database)/documents/rides/$(rideId)).data.riderId == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
            )
          )
        );
        allow delete: if isAdmin();
      }

      /* Masked call log (NEW). Written by Cloud Functions only. */
      match /calls/{callId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    /* ================= NEARBY CARS (NEW) ================= */
    /* A bare position per free driver, so passengers see cars nearby
       without reading driver records. */

    match /driverLocations/{driverId} {
      allow read: if signedIn();
      allow write: if isAdmin() || (signedIn() && request.auth.uid == driverId);
    }

    /* ================= WORKING CITIES (NEW) ================= */

    match /cities/{cityId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* ================= DRIVER WALLETS ================= */

    match /driverWallets/{driverId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == driverId);
      allow write: if isAdmin();
    }

    match /driverWallets/{driverId}/transactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == driverId);
      allow write: if isAdmin();
    }

    /* Subscription revenue on the dashboard reads transactions across all
       drivers at once, which needs this collection group rule (NEW). */
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin();
    }

    /* ================= DRIVER PAYOUTS ================= */

    match /driverPayouts/{payoutId} {
      allow read: if isAdmin() || (signedIn() && resource.data.driverId == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    /* ================= PAYMENTS ================= */

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        signedIn() &&
        (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid
        )
      );
      allow create, update, delete: if isAdmin();
    }

    /* ================= REPORTS ================= */

    match /reports/{reportId} {
      allow read: if isAdmin() || (
        signedIn() &&
        resource.data.reporterId == request.auth.uid
      );
      allow create: if isAdmin() || signedIn();

      /* The reporter may only touch the reply markers; everything else
         about a case is set by admins (UPDATED). */
      allow update: if isAdmin() || (
        signedIn() &&
        resource.data.reporterId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "lastReplyAt", "lastReplyBy", "updatedAt", "reporterSeenAt"
        ])
      );
      allow delete: if isAdmin();

      /* Support replies. The app sends senderRole "driver" or "rider"
         (UPDATED, it previously only allowed "user"). */
      match /messages/{messageId} {
        allow read: if isAdmin() || (
          signedIn() &&
          get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid
        );
        allow create: if isAdmin() || (
          signedIn() &&
          request.resource.data.senderRole in ["driver", "rider", "user"] &&
          get(/databases/$(database)/documents/reports/$(reportId)).data.reporterId == request.auth.uid
        );
        allow update, delete: if isAdmin();
      }
    }

    /* ================= FLEETS (functions/fleet.js) ================= */
    /* Created and changed by admins and the fleet functions. The owner may
       change the fleet's contact details and dispatch timing only. */

    match /fleets/{fleetId} {
      allow read: if isAdmin() || fleetStaffOf(fleetId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        fleetOwnerOf(fleetId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["phone", "address", "dispatchLeadMinutes", "vatNumber", "invoiceVatPercent", "invoiceFooter", "updatedAt"]) &&
        request.resource.data.get("vatNumber", "") is string &&
        request.resource.data.get("vatNumber", "").size() <= 30 &&
        request.resource.data.get("invoiceFooter", "") is string &&
        request.resource.data.get("invoiceFooter", "").size() <= 1000 &&
        request.resource.data.get("invoiceVatPercent", 0) is number &&
        request.resource.data.get("invoiceVatPercent", 0) >= 0 &&
        request.resource.data.get("invoiceVatPercent", 0) <= 100 &&
        request.resource.data.get("dispatchLeadMinutes", 20) is int &&
        request.resource.data.get("dispatchLeadMinutes", 20) >= 0 &&
        request.resource.data.get("dispatchLeadMinutes", 20) <= 180
      );

      /* Phone booking customers, kept per fleet. Staff may edit a
         customer's name and notes; bookings are counted by the server. */
      /* A contact card is made as soon as the operator types a new
         number, keyed by the number (+44...). Staff keep its name, notes
         and saved places; bookings and journeys are kept by the server. */
      match /customers/{customerId} {
        allow read: if isAdmin() || fleetStaffOf(fleetId);
        allow create: if isAdmin() || (
          fleetStaffOf(fleetId) &&
          customerId.matches('[+][0-9]{8,15}') &&
          request.resource.data.phone == customerId &&
          request.resource.data.keys().hasOnly(["phone", "name", "notes", "places", "createdAt", "createdBy"]) &&
          request.resource.data.get("name", "") is string &&
          request.resource.data.get("name", "").size() <= 80
        );
        allow update: if isAdmin() || (
          fleetStaffOf(fleetId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["name", "notes", "places", "addresses", "journeys"]) &&
          request.resource.data.get("places", []).size() <= 20 &&
          request.resource.data.get("name", "").size() <= 80 &&
          request.resource.data.get("notes", "").size() <= 500
        );
        allow delete: if isAdmin();
      }

      /* Account clients the fleet bills. Staff keep them; an account with
         history is switched off with active, not deleted. */
      match /accounts/{accountId} {
        allow read: if isAdmin() || fleetStaffOf(fleetId);
        allow create, update: if isAdmin() || (
          fleetStaffOf(fleetId) &&
          request.resource.data.keys().hasOnly(["company", "address", "telephone", "email", "active", "createdAt", "createdBy", "updatedAt"]) &&
          request.resource.data.company is string &&
          request.resource.data.company.size() > 0 &&
          request.resource.data.company.size() <= 120 &&
          request.resource.data.get("address", "").size() <= 300 &&
          request.resource.data.get("telephone", "").size() <= 30 &&
          request.resource.data.get("email", "").size() <= 200 &&
          request.resource.data.get("active", true) is bool
        );
        allow delete: if isAdmin();
      }

      /* Money records, written only by functions/fleet.js. */
      match /driverAccounts/{driverId} {
        allow read: if isAdmin() || fleetStaffOf(fleetId) ||
          (signedIn() && request.auth.uid == driverId);
        allow write: if isAdmin();
      }
      match /driverPayments/{paymentId} {
        allow read: if isAdmin() || fleetStaffOf(fleetId) ||
          (signedIn() && resource.data.driverId == request.auth.uid);
        allow write: if isAdmin();
      }
      match /invoices/{invoiceId} {
        allow read: if isAdmin() || fleetStaffOf(fleetId);
        allow write: if isAdmin();
      }
    }

    match /fleetManagers/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId) ||
        (resource != null && fleetStaffOf(resource.data.fleetId));
      /* Staff keep their own phone for office calls (fleetCall rings it
         first); everything else is set by admins and functions/fleet.js. */
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["phone"]) &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('[+][0-9]{8,15}')
      );
      allow create, delete: if isAdmin();
    }

    match /fleetWallets/{fleetId} {
      allow read: if isAdmin() || fleetStaffOf(fleetId);
      allow write: if isAdmin();

      match /transactions/{transactionId} {
        allow read: if isAdmin() || fleetStaffOf(fleetId);
        allow write: if isAdmin();
      }
    }

    /* Zone queues, kept by functions/fleet.js. The office sees them, and
       so do the fleet's drivers (their place in the queue). */
    match /fleetQueues/{fleetId} {
      allow read: if isAdmin() || fleetStaffOf(fleetId) || (
        signedIn() &&
        get(/databases/$(database)/documents/drivers/$(request.auth.uid))
          .data.get("fleetId", null) == fleetId
      );
      allow write: if isAdmin();
    }

    match /fleetInvites/{phone} {
      allow read: if isAdmin() || (resource != null && fleetStaffOf(resource.data.fleetId));
      allow write: if isAdmin();
    }

    /* ================= ADMINS ================= */

    match /admins/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isSuperAdmin();
    }
  }
}