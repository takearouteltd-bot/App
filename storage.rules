rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    function sensibleFile() {
      return request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType == 'application/pdf');
    }

    /* Only the owner and admins can read or list these files. Photos and
       documents are shown through the download link saved with them, so
       passengers and fleet staff still see what they are given a link to. */
    match /riders/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin() ||
        (signedIn() && request.auth.uid == userId && sensibleFile());
    }

    match /drivers/{userId}/{allPaths=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if isAdmin() ||
        (signedIn() && request.auth.uid == userId && sensibleFile());
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
